# macOS
.DS_Store

# Python environments
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# JavaScript builds and dependencies (any package in the repo)
node_modules/
.next/
.output/
.wxt/

# Environment files hold keys: never commit them, in any folder. Only the
# examples (placeholder values) are tracked.
.env
.env.*
!.env.example

# Personal data and old scripts that must never be committed
kelsie_memory.json
kelsie_cli_transformers.py

# The old Python app's local database (repo root only, so folders like
# ml/kelsie-intent/data/ aren't caught by this)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local backup files
*-before-reminders.py
*-before-reminders.html

# Temporary test files
test_openai.py

# Archived legacy files
archive/
# Packaged Chrome extension zips
dist/
