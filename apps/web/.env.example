# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API Keys.
#
# Both values are only read by server code: the browser never talks to
# Supabase directly. Never put the secret / service_role key here; the app
# doesn't need it.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# AI notes (Groq). Server-only: never sent to the browser or the extension.
# GROQ_MODEL is optional; it defaults to llama-3.1-8b-instant.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# Set to "on" once Google sign-in is set up in Google Cloud and Supabase.
# Until then the "Continue with Google" button is hidden.
GOOGLE_SIGN_IN=off
