# Copy this file to .env.local and fill in the values from
# Supabase -> Project Settings -> API Keys.
#
# Both values are only read by server code: the browser never talks to
# Supabase directly. Never put the secret / service_role key here; the app
# doesn't need it.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
